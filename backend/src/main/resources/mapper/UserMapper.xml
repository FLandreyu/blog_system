<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunyongjie.blog.mapper.UserMapper">

    <sql id="baseColumns">
        id, username, password, nickname, email, avatar, role, create_time, update_time
    </sql>

    <select id="selectById" resultType="User">
        SELECT
        <include refid="baseColumns"/>
        FROM `user`
        WHERE id = #{id}
    </select>

    <select id="selectByUsername" resultType="User">
        SELECT
        <include refid="baseColumns"/>
        FROM `user`
        WHERE username = #{username}
    </select>

    <select id="countByUsername" resultType="int">
        SELECT COUNT(*)
        FROM `user`
        WHERE username = #{username}
    </select>

    <!-- create_time / update_time 交给数据库默认值，不用应用层操心 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `user` (username, password, nickname, email, avatar, role)
        VALUES (#{username}, #{password}, #{nickname}, #{email}, #{avatar}, #{role})
    </insert>

    <update id="updateProfile">
        UPDATE `user`
        SET nickname = #{nickname},
            avatar   = #{avatar}
        WHERE id = #{id}
    </update>

</mapper>
