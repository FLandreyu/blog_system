<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunyongjie.blog.mapper.TagMapper">

    <select id="selectAll" resultType="Tag">
        SELECT id, name, create_time
        FROM tag
        ORDER BY id ASC
    </select>

    <select id="selectByArticleId" resultType="Tag">
        SELECT t.id, t.name, t.create_time
        FROM tag t
                 JOIN article_tag art ON art.tag_id = t.id
        WHERE art.article_id = #{articleId}
        ORDER BY t.id ASC
    </select>

    <select id="selectByName" resultType="Tag">
        SELECT id, name, create_time
        FROM tag
        WHERE name = #{name}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tag (name)
        VALUES (#{name})
    </insert>

    <!-- 一条 INSERT 写多行，比在 Java 里循环调用少很多次网络往返 -->
    <insert id="insertArticleTags">
        INSERT INTO article_tag (article_id, tag_id)
        VALUES
        <foreach collection="tagIds" item="tagId" separator=",">
            (#{articleId}, #{tagId})
        </foreach>
    </insert>

    <delete id="deleteArticleTags">
        DELETE FROM article_tag
        WHERE article_id = #{articleId}
    </delete>

</mapper>
